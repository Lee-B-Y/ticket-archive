# Web login. Replace every placeholder before exposing the service.
APP_USERNAME=admin
APP_PASSWORD=change-this-password
APP_SECRET=replace-with-at-least-32-random-characters
API_KEY=replace-with-a-separate-long-random-api-key
COOKIE_SECURE=false

# direct: read the mailbox bound to 12306
# forward: read a receiving mailbox to which the 12306 mailbox forwards mail
MAIL_MODE=direct
IMAP_EMAIL=your-mailbox@example.com
IMAP_AUTH_CODE=your-imap-authorization-code
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# Required in forward mode: the mailbox address bound to the 12306 account.
SOURCE_EMAIL=

# Forwarding verification requests are confirmed automatically when their
# subject and positive HTTPS action are unambiguous.
AUTO_CONFIRM_FORWARDING=true

# Run once on startup and then at this interval. Minimum: 5 minutes.
SYNC_ON_START=true
SYNC_INTERVAL_MINUTES=1440
TZ=Asia/Shanghai
